# Central Alex Gateway — example environment file (APP_* / *_LIMIT* / RUNPOD_* ...).
#
#   install -m 600 -o root -g root .env.example /etc/alex-gateway/gateway.env   # bare metal
#   cp .env.example .env && chmod 600 .env                                      # docker compose
#
# ================================ WARNINGS ================================
# * NO REAL SECRET IS IN THIS FILE. Every value below is a placeholder.
# * RUNPOD_API_KEY is the MASTER ACCOUNT CREDENTIAL. It is server-side only: it must never
#   reach a client installation, a browser, a log line, an image layer, a backup, the
#   Gateway database or a support ticket. The trust boundary exists precisely so that
#   installations never hold this key (docs/gateway-deployment.md).
# * JWT_SECRET signs short-lived installation tokens. Treat it as a password: anyone holding
#   it can mint tokens for any installation id it names.
# * A real deployment file must be mode 0600 and owned by root (systemd reads EnvironmentFile
#   as the service manager, before dropping privileges, so root:root 0600 works together with
#   a non-root User=). Never commit it, never bake it into the image.
# * The Gateway database holds installations, activation-code digests, the global compute
#   lease, idempotency records and the audit trail. It never holds provider keys, prompts or
#   completions, so it is not a secret store.
# * Field names below are the upper-case pydantic-settings names of GatewaySettings
#   (apps/gateway/gateway/config.py). An unknown variable is ignored, not an error — a typo
#   silently falls back to the default, so review this file against the release notes.
# =========================================================================

# --- Identity ---------------------------------------------------------------------------
# development | production | test. `production` turns on the stricter validation: JWT_SECRET
# must be at least 48 characters and may not be the placeholder below.
APP_ENV=production
# Client/server contract version. A mismatching client is rejected with
# `gateway_protocol_mismatch` instead of running against an incompatible contract.
GATEWAY_PROTOCOL_VERSION=1
# Reported by GET /health. PRODUCT/VERSION are informational; changing them does not change
# the protocol.
PRODUCT=alex-llm-gateway
VERSION=0.9.3

# --- Database ---------------------------------------------------------------------------
# PostgreSQL 16, its OWN role and its OWN database. Never the local Alex SQLite database.
# The `+psycopg` suffix selects the psycopg 3 driver that requirements.txt installs; a bare
# `postgresql://` URL would try to load psycopg2 and fail at startup.
# Dev/tests may use:  sqlite:///./gateway.db
DATABASE_URL=postgresql+psycopg://alex_gateway:change-me-strong-db-password@localhost:5432/alex_gateway
# Compose-only: used by docker-compose.example.yml for the postgres service and interpolated
# into the gateway's DATABASE_URL. Keep it identical to the password in DATABASE_URL above.
# The Gateway application itself does not read POSTGRES_PASSWORD.
POSTGRES_PASSWORD=change-me-strong-db-password

# --- Installation tokens -----------------------------------------------------------------
# Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# The placeholder below is 40 characters, so `APP_ENV=production` refuses to start until you
# replace it. Tokens are short-lived (JWT_EXPIRE_MINUTES), which makes rotating this key cheap.
JWT_SECRET=change-me-generate-a-48-character-secret
JWT_EXPIRE_MINUTES=15
JWT_ISSUER=alex-gateway
JWT_AUDIENCE=alex-installation

# --- Enrollment and rate limits -----------------------------------------------------------
# An activation code printed by `python -m gateway.cli create-code --label "PC A"` is valid for
# this long, single-use, and stored only as a digest.
ACTIVATION_TTL_MINUTES=60
# Sliding window for all limits below. The limiter is IN-PROCESS: run exactly one worker.
RATE_WINDOW_SECONDS=60
ENROLLMENT_RATE_LIMIT=20
TOKEN_RATE_LIMIT=120
COMPUTE_RATE_LIMIT=30
INFERENCE_RATE_LIMIT=60

# --- RunPod (master credential: server-side only) -----------------------------------------
# The Gateway starts at most ONE managed Pod for the whole account and never deletes the
# Network Volume. An empty key means "not configured": the Gateway still serves /health.
RUNPOD_API_KEY=change-me-runpod-master-key-server-side-only
# Read-only balance snapshot source (GraphQL query, no mutation).
RUNPOD_GRAPHQL_URL=https://api.runpod.io/graphql
# The existing Alex product Network Volume that holds the model. Must match the volume the
# model is stored on; the Gateway never deletes it.
RUNPOD_NETWORK_VOLUME_ID=uwgeaie5b0
RUNPOD_DATACENTER=US-TX-3
RUNPOD_MIN_VRAM_GB=48
RUNPOD_MIN_CUDA_VERSION=12.8
RUNPOD_IMAGE=runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404
# llama.cpp port inside the Pod (not published) and the Pod's authenticated gateway port
# (published through RunPod HTTPS and proxied by this service).
RUNPOD_LLM_PORT=8080
RUNPOD_GATEWAY_PORT=9000
# Seconds allowed for capacity -> create -> container -> model load before the managed Pod is
# released. A startup timeout never leaves a stray Pod behind.
RUNPOD_STARTUP_TIMEOUT=900

# --- Model ------------------------------------------------------------------------------
# mock | llamacpp. Production uses llamacpp; mock is a local/dev path and must never be
# presented as real AI.
LLM_PROVIDER=llamacpp
LLM_MODEL=orcarouter-qwen38-27b-q5km
# Key protecting the Pod's llama.cpp gateway port. Injected into the Pod bootstrap server-side
# and never handed to a client.
LLM_API_KEY=change-me-long-random-pod-proxy-key

# --- Money ceilings (product rules; the client can only ask for something stricter) --------
# $1.20/hour and $3.00/session are the product ceilings in config.py. A higher value makes the
# Gateway REFUSE TO START rather than quietly spending more.
MAX_HOURLY_PRICE=1.20
MAX_SESSION_BUDGET=3.00
# Idle timeout for the global managed compute, and how often the controller observes it.
COMPUTE_IDLE_MINUTES=10
COMPUTE_POLL_SECONDS=5

# --- Shared balance cache -------------------------------------------------------------------
# Read-only. Faster while compute is active, slower while idle, so N installations do not turn
# into N upstream account queries.
BALANCE_ACTIVE_SECONDS=5
BALANCE_IDLE_SECONDS=15

# --- Inference policy (llama.cpp runs with --parallel 1, so the Gateway serializes) ---------
# Queue capacity per gateway; a full queue is `gateway_queue_full`, not an unbounded wait.
INFERENCE_QUEUE_SIZE=8
INFERENCE_QUEUE_TIMEOUT_SECONDS=120
# Total request budget and the per-upstream-attempt timeout. INFERENCE_TIMEOUT_SECONDS must be
# greater than the reverse proxy's proxy_read_timeout for SSE streams to survive.
INFERENCE_TIMEOUT_SECONDS=900
INFERENCE_UPSTREAM_TIMEOUT_SECONDS=120
