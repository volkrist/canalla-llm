{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBundleCommand": "bash src-tauri/stage-native-runtime.sh"
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": [
      "sidecar/README.txt",
      "sidecar/alex-backend",
      "sidecar/alex-host-loop",
      "runtime/tor"
    ],
    "linux": {
      "deb": {
        "depends": ["libsecret-tools"]
      }
    }
  }
}
