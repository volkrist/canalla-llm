{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Export only to a path selected in the save dialog; open HTTP(S) links in the system browser.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
