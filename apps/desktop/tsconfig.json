{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"],
  // installer-policy.test.ts is a Node-context guard: it reads the installer configuration
  // with node:fs, and this browser project carries no @types/node. vitest runs it; see the
  // header of that file. Excluded here so `tsc -b` stays a browser-only check.
  "exclude": [
    "src/lib/installer-policy.test.ts",
    "src/lib/installer-migration.test.ts",
    "src/lib/linux-packaging.test.ts"
  ]
}
