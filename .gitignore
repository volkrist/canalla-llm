.env
.env.*
!.env.example
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc
*.db
*.db-*
node_modules/
dist/
dist-e2e/
*.tsbuildinfo
*.egg-info/
target/
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/icons/*
!apps/desktop/src-tauri/icons/source.svg
!apps/desktop/src-tauri/icons/icon.ico
!apps/desktop/src-tauri/icons/icon.png
# A14/A25: the Linux bundle (tauri.linux.conf.json) references these generated PNGs, so they must
# be tracked: a clean checkout has no icon-generation step, and `linux-packaging.test.ts` proves
# the bundle names real files. Regenerate from source.svg with `npx tauri icon icons/source.svg`.
!apps/desktop/src-tauri/icons/32x32.png
!apps/desktop/src-tauri/icons/64x64.png
!apps/desktop/src-tauri/icons/128x128.png
!apps/desktop/src-tauri/icons/128x128@2x.png
*.log
*.cred.dpapi
playwright-report/
test-results/
.DS_Store
.data/
apps/desktop/src-tauri/sidecar/alex-backend/
apps/desktop/src-tauri/sidecar/*.exe
apps/desktop/src-tauri/sidecar/SHA256SUMS.txt
artifacts/final-acceptance/
apps/backend/build/

# The bundled Tor runtime: fetched and verified by scripts/fetch-tor-runtime.py from the pin in
# scripts/tor-runtime.json, never committed.
apps/desktop/src-tauri/runtime/

# Updater signing material: the private half never belongs in the tree. The public half lives in
# tauri.conf.json and the test signature fixtures, and the real key stays outside the repository.
*.key
*.key.pub
