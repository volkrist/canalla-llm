{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alex-llm.local/evaluation/task.schema.json",
  "title": "Alex LLM evaluation task",
  "type": "object",
  "required": [
    "id",
    "title",
    "category",
    "difficulty",
    "natural_user_prompt",
    "preconditions",
    "workspace_setup",
    "expected_capabilities",
    "expected_tool_family",
    "forbidden_tools",
    "success_criteria",
    "verification",
    "max_tool_calls",
    "max_runtime_seconds",
    "max_paid_cost_usd",
    "cleanup",
    "weak_model_risks",
    "deterministic_fallback_expected",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z]{2}-[0-9]{2}$" },
    "title": { "type": "string", "minLength": 3 },
    "category": {
      "type": "string",
      "enum": [
        "local-computer",
        "coding",
        "web",
        "tinyfish-routing",
        "tor",
        "rag",
        "memory",
        "autonomous",
        "recovery",
        "safety",
        "weak-model",
        "efficiency",
        "ambiguity",
        "deep-research",
        "high-autonomy"
      ]
    },
    "difficulty": { "type": "string", "enum": ["simple", "standard", "deep"] },
    "natural_user_prompt": { "type": "string", "minLength": 8 },
    "preconditions": { "type": "array", "items": { "type": "string" } },
    "workspace_setup": { "type": "object" },
    "expected_capabilities": { "type": "array", "items": { "type": "string" } },
    "expected_tool_family": { "type": "array", "items": { "type": "string" } },
    "forbidden_tools": { "type": "array", "items": { "type": "string" } },
    "success_criteria": { "type": "array", "items": { "type": "object" } },
    "verification": { "type": "object" },
    "max_tool_calls": { "type": "integer", "minimum": 1 },
    "max_runtime_seconds": { "type": "integer", "minimum": 1 },
    "max_paid_cost_usd": { "type": "number", "minimum": 0 },
    "cleanup": { "type": "object" },
    "weak_model_risks": { "type": "array", "items": { "type": "string" } },
    "deterministic_fallback_expected": { "type": "boolean" },
    "notes": { "type": "string" },
    "suite": { "type": "string" },
    "live": { "type": "boolean" },
    "expected_mock_status": {
      "type": "string",
      "enum": ["PASS", "PARTIAL", "FAIL", "SKIPPED"]
    }
  }
}
