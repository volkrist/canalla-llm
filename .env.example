# Template only. Copy to apps/backend/.env, or run scripts/setup-backend.ps1.
APP_ENV=development
DATABASE_URL=sqlite:///./alex.db
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:1420","http://127.0.0.1:1420","http://tauri.localhost","https://tauri.localhost","tauri://localhost"]
LLM_PROVIDER=mock
LLM_BASE_URL=http://127.0.0.1:8080
LLM_MODEL=orcarouter-qwen38-27b-q5km
LLM_API_KEY=
# runpod resolves the current managed Pod automatically. static uses LLM_BASE_URL
# (HTTPS with API key, or localhost through an independently configured SSH tunnel).
LLM_CONNECTION_MODE=runpod
RUNPOD_GATEWAY_PORT=9000
# Compute credentials stay on the backend. Never use a VITE_ prefix for secrets.
RUNPOD_API_KEY=
RUNPOD_NETWORK_VOLUME_ID=uwgeaie5b0
RUNPOD_DATACENTER=US-TX-3
RUNPOD_MIN_VRAM_GB=48
RUNPOD_MAX_HOURLY_PRICE=1.20
RUNPOD_MAX_SESSION_BUDGET=3.00
RUNPOD_AUTO_STOP_MINUTES=10
RUNPOD_SEARCH_INTERVAL=30
RUNPOD_STARTUP_TIMEOUT=900
RUNPOD_IMAGE=runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404
RUNPOD_MIN_CUDA_VERSION=12.8
RUNPOD_LLM_PORT=8080
ADMIN_EMAILS=[]
ALLOW_USER_COMPUTE_START=false
COMPUTE_POLL_SECONDS=5
COMPUTE_BACKGROUND_ENABLED=true
